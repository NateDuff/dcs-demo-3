---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/Hero.astro'
import Services from '../components/Services.astro'
import CTA from '../components/CTA.astro'
// C-486 §9.5 step 2 — Stats.astro and Testimonials.astro removed.
// They published fabricated third-party claims ("Sarah Chen, CEO of TechStart",
// "250+ Projects Delivered", "120+ Happy Clients", "18 Design Awards") for a
// business that does not exist. Per C-365 the honest disposition of an
// unsubstantiable claim is removal, not a more plausible invention.
import { t, getPageSeo } from '@duffcloudservices/cms-astro'

const seo = getPageSeo('home')
---

<Layout 
  title={seo?.title ?? "Award-Winning Creative Agency"}
  description={seo?.description ?? "Transform your brand with Pixel Forge Creative."}
>
  <Hero
    title={t('home', 'hero.title', 'We Build Digital Experiences That Matter')}
    subtitle={t('home', 'hero.subtitle', 'Award-winning creative agency specializing in brand identity, web design, and digital marketing that drives results.')}
    cta={t('home', 'hero.cta', 'Start Your Project')}
    ctaLink="/contact"
    page="home"
  />
  
  <Services />

  <CTA
    title={t('home', 'cta.title', 'Ready to Transform Your Brand?')}
    description={t('home', 'cta.description', "Let's create something amazing together.")}
    buttonText={t('global', 'cta.getStarted', 'Get Started')}
    buttonLink="/contact"
    page="home"
  />
</Layout>
