---
import { t } from '@duffcloudservices/cms-astro'

const testimonials = [
  {
    key: '1',
    quote: t('home', 'testimonials.quote1', 'Pixel Forge transformed our brand completely. Their creative vision exceeded all expectations.'),
    author: t('home', 'testimonials.author1', 'Sarah Chen, CEO of TechStart')
  },
  {
    key: '2',
    quote: t('home', 'testimonials.quote2', 'The website they built for us increased conversions by 150%. Incredible work.'),
    author: t('home', 'testimonials.author2', 'Marcus Rivera, Founder of GreenLeaf')
  }
]
---

<section class="py-20 bg-white" data-section="testimonials" data-section-label="Testimonials">
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4" data-text-key="home.testimonials.title">{t('home', 'testimonials.title', 'What Our Clients Say')}</h2>
    </div>
    
    <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto" data-dynamic="true">
      {testimonials.map((testimonial) => (
        <div class="bg-slate-50 p-8 rounded-xl">
          <svg class="w-10 h-10 text-purple-300 mb-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
          </svg>
          <p class="text-lg text-slate-700 mb-6" data-text-key={`home.testimonials.quote${testimonial.key}`}>{testimonial.quote}</p>
          <div>
            <div class="font-semibold text-slate-900" data-text-key={`home.testimonials.author${testimonial.key}`}>{testimonial.author}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
